   "source": [
    "from pyspark.sql.functions import regexp_replace, col\n",
    "\n",
    "df = spark.table(\"uat.mukesh.bronze_customer\")\n",
    "\n",
    "for c in df.columns:\n",
    "    df = df.withColumn(\n",
    "        c,\n",
    "        regexp_replace(col(c).cast(\"string\"), \" \", \"_\")\n",
    "    )\n",
    "\n",
    "display(df)"
   ]
  }
